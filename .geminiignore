*.sublime-project

.DS_Store

Thumbs.db

Desktop.ini

*.swp

*~ 



# Notebooks / checkpoints

.ipynb_checkpoints/

# Se desejar evitar notebooks inteiros, descomente a linha abaixo:

# *.ipynb



# Terraform / cloud state

.terraform/

*.tfstate

*.tfstate.backup

*.tfvars

*.secret.tfvars



# Outros artefatos comuns

node_repl_history

.pnp.*

.pnp.js



# Evitar leitura do histórico Git (opcional)

.git/



# Observações:

# - Mantenha arquivos de configuração (package.json, requirements.txt, Dockerfile, etc.)

#   para que a IA possa analisar a estrutura do projeto.

# - Ajuste/remoção de entradas conforme necessidades específicas do seu repositório.