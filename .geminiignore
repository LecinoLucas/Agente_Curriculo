# .geminiignore — Evitar leitura de pastas pesadas, builds, mídias e segredos pela IA.

# Ajuste conforme a stack (Node/Python/Java/Go/Rust/Flutter/etc).



# Dependências

node_modules/

**/node_modules/

vendor/

**/vendor/

.pnpm-store/

bower_components/



# Ambientes virtuais (Python)

venv/

.venv/

env/

ENV/

.virtualenv/

pip-wheel-metadata/

__pycache__/

*.py[cod]

*$py.class



# Builds / artefatos binários

dist/

build/

out/

release/

target/

bin/

obj/

*.exe

*.dll

*.so

*.dylib

*.class

*.jar

*.war

*.apk

*.aab



# Frameworks JS / web

.next/

.next/cache/

.nuxt/

.storybook/

storybook-static/

.vite/

.cache/

.eslintcache

public/build/



# Mobile / Native

android/

ios/

Pods/

DerivedData/

build/



