VITE_API_URL=http://localhost:8000/api/v1
VITE_API_BASE_URL=http://127.0.0.1:8000
# Para LAN/dev, `npm run dev:full -- --network` injeta dinamicamente:
# VITE_API_URL=http://SEU_IP_LOCAL:8000/api/v1
# VITE_API_BASE_URL=http://SEU_IP_LOCAL:8000

# URL do novo candidate-portal standalone (porta 5174 em dev).
# Em produção: substituir pelo domínio/subdomínio real do portal (ex: https://vagas.marajo.com.br).
VITE_CANDIDATE_PORTAL_URL=http://localhost:5174

# URL do protótipo do portal do candidato (porta 5175 em dev).
# Em produção/local alternativo: apontar para a instância do protótipo.
VITE_CANDIDATE_PORTAL_PROTOTYPE_URL=http://localhost:5175

VITE_GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
# Deve ser o mesmo Client ID configurado no backend em GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com

# Google OAuth local development
# Configure este mesmo OAuth Client no Google Cloud como "Web application" (APIs & Services > Credentials).
# Authorized JavaScript origins (TODAS devem ser adicionadas manualmente):
# - http://localhost:5173
# - http://127.0.0.1:5173
# - http://localhost:5174
# - http://127.0.0.1:5174
# - http://SEU_IP_LOCAL:5173, se usar rede local.
# - http://SEU_IP_LOCAL:5174, se usar rede local.
#
# Sem esses origins, o GIS retorna no console:
#   [GSI_LOGGER]: The given origin is not allowed for the given client ID
# Não há fix por código; é exclusivamente configuração no Google Cloud.
