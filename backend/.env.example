# Resume AI System Backend Configuration
# SECURITY: Never commit .env with real secrets. Keep .env in .gitignore.

# =============================================================================
# APPLICATION
# =============================================================================
APP_ENV=development
APP_SECRET_KEY=your-secret-key-here-min-32-chars
APP_DEBUG=false
# Frontends autorizados a enviar cookies (credentials: include).
# NÃO usar wildcard ("*") com allow_credentials=True.
# Dev: inclui frontend interno (5173) e candidate-portal standalone (5174).
# Em produção: substituir pelos domínios reais, ex:
#   CORS_ORIGINS=["https://rh.marajo.com.br","https://vagas.marajo.com.br"]
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/resume_ai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20

# =============================================================================
# JWT (Authentication)
# =============================================================================
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# DEVELOPMENT ADMIN
# =============================================================================
DEV_ADMIN_EMAIL=admin@resume.ai
DEV_ADMIN_PASSWORD=Smoke123!
DEV_ADMIN_FULL_NAME=Administrador Dev

# =============================================================================
# DEVELOPMENT FLAGS
# =============================================================================
ENABLE_DEV_MOCK=false
# DEV/TEST ONLY. Enables POST /api/v1/public/auth/dev-login for local candidate-portal QA.
# Must remain false in staging/production.
ENABLE_DEV_CANDIDATE_LOGIN=false

# =============================================================================
# AWS S3 / FILE STORAGE
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=resume-ai-files
S3_PRESIGNED_URL_EXPIRE_SECONDS=900

# =============================================================================
# AI PROVIDER CONFIGURATION
# =============================================================================
AI_PROVIDER=google
AI_MODEL_ID=gemini-2.5-flash
AI_PROVIDER_TIMEOUT_SECONDS=300
AI_MAX_TOKENS=3000
AI_MAX_RETRIES=0
ALLOW_AI_TOKEN_SPEND=true

ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=4096

# =============================================================================
# GEMINI API CONFIGURATION (Google)
# SECURITY: Keep real keys ONLY in .env, never in git or code
# Format: Explicit numbered fields instead of CSV parsing
# Failover: If key_1 fails with 429 (rate limit) or 400 (invalid), tries key_2, etc.
# Invalid keys (400 "API key not valid") are permanently marked invalid in memory
# =============================================================================
GOOGLE_API_KEY_1=
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=
GOOGLE_API_KEY_4=
GOOGLE_API_KEY_5=

GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MAX_CONCURRENT_REQUESTS=1
AI_ANALYSIS_RATE_LIMIT_COOLDOWN_SECONDS=60
ANALYSIS_TASK_SOFT_TIME_LIMIT_SECONDS=420
ANALYSIS_TASK_TIME_LIMIT_SECONDS=480
AI_ANALYSIS_MAX_RESUME_CHARS=3000
AI_ANALYSIS_MAX_JOB_CHARS=2000
AI_ANALYSIS_MAX_OUTPUT_TOKENS=2500

# =============================================================================
# DATA PROCESSING
# =============================================================================
SKILL_CATALOG_SOURCE=database
# URL pública do candidate-portal — usada para montar o link de definir-senha.
# DEV: deve usar o MESMO host do candidate-portal e da API (ver CORS_ORIGINS).
# Misturar localhost/127.0.0.1/IP-de-rede quebra o cookie de sessão (SameSite=Lax).
CANDIDATE_PORTAL_PUBLIC_URL=http://localhost:5174

# =============================================================================
# EMAIL DELIVERY (SMTP)
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Marajó RH
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=10

# =============================================================================
# ERP / PROTHEUS
# =============================================================================
ERP_INTEGRATION_MODE=dry_run
PROTHEUS_BASE_URL=
PROTHEUS_AUTH_MODE=basic
PROTHEUS_USERNAME=
PROTHEUS_PASSWORD=
PROTHEUS_TOKEN=
PROTHEUS_TIMEOUT_SECONDS=30
PROTHEUS_REAL_SEND_ENABLED=false
ERP_ALLOW_REAL_SEND=false

# =============================================================================
# CELERY (Task Queue)
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# =============================================================================
# GOOGLE OAUTH (Calendar Integration)
# SECURITY: client_secret is OAuth app credential, not user key
# =============================================================================
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google-calendar/callback
GOOGLE_CALENDAR_SCOPES=openid email profile https://www.googleapis.com/auth/calendar.events

# Google OAuth local development
# Configure este mesmo OAuth Client no Google Cloud como "Web application".
# Authorized JavaScript origins, para login Google via frontend:
# - http://localhost:5173
# - http://127.0.0.1:5173
# - http://SEU_IP_LOCAL:5173, se usar rede local.
# Authorized redirect URIs, para integração Google Calendar via backend:
# - http://localhost:8000/api/v1/integrations/google-calendar/callback

# =============================================================================
# ENCRYPTION
# =============================================================================
FIELD_ENCRYPTION_KEY=your-base64-32-byte-key

# =============================================================================
# OBSERVABILITY
# =============================================================================
SENTRY_DSN=
