# =============================================================================
# APPLICATION
# =============================================================================
APP_ENV=development                      # development | staging | production
APP_SECRET_KEY=e734a97c32adfd5ab2334590338487b14cde901c97f95aafacd7cc3b1f393c51
APP_DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]  # Em development, localhost/127.0.0.1 com portas variaveis tambem sao aceitos pelo backend. Em producao, defina aqui apenas as origens reais permitidas.

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql+asyncpg://LecinoLucas:020219@localhost:5432/resume_ai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20

# =============================================================================
# JWT
# =============================================================================
JWT_SECRET_KEY=f543efd10f0f7fc9584032fd7951b43ea4ecd54b07e6722d51d3adfa774fd29d
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# DEVELOPMENT ADMIN (usado pelo seed automatico em npm run dev:full)
# =============================================================================
DEV_ADMIN_EMAIL=admin@resume.ai
DEV_ADMIN_PASSWORD=Admin123!
DEV_ADMIN_FULL_NAME=Administrador Dev

# =============================================================================
# DEVELOPMENT FLAGS
# =============================================================================
ENABLE_DEV_MOCK=true                    # true apenas em ambiente local

# =============================================================================
# AWS S3 / FILE STORAGE
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=resume-ai-files
S3_PRESIGNED_URL_EXPIRE_SECONDS=900     # 15 minutos

# =============================================================================
# AI
# =============================================================================
ALLOW_AI_TOKEN_SPEND=false             # true libera chamadas reais aos provedores e consumo de tokens
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=4096
GOOGLE_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# =============================================================================
# CELERY (Task Queue)
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# =============================================================================
# MONITORING (opcional)
# =============================================================================
SENTRY_DSN=
