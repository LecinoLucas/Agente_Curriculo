# .cursorignore / .codexignore
# Otimizado para modelos OpenAI Codex e GPT-4

# --- Dependências e Runtime ---
node_modules/
bower_components/
venv/
.venv/
env/
__pycache__/
*.py[cod]

# --- Builds e Outputs ---
dist/
build/
out/
.next/
.nuxt/
target/
bin/
obj/

# --- Logs e Performance ---
*.log
logs/
.npm/
.eslintcache
.stylelintcache
coverage/
.nyc_output/

# --- Arquivos de Sistema e IDEs ---
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo

# --- Dados e Configurações Sensíveis ---
.env
.env.*
*.pem
*.key
*.cert
*.p12
*.jks
credentials.json
secrets.json

# --- Arquivos Binários e Pesados (Economia de Contexto) ---
*.exe
*.dll
*.so
*.dylib
*.zip
*.tar.gz
*.rar
*.7z
*.pdf
*.docx

# --- Mídias (Imagens/Vídeos) ---
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.ico
*.mp4
*.webm
*.wav
*.mp3

# --- Bancos de Dados ---
*.sqlite
*.sqlite3
*.db
*.sql
*.dump

# --- Git Internals ---
.git/
.gitignore

# NOTA: O Codex se beneficia muito de ler o seu 'package.json' ou 'requirements.txt'
# Portanto, nunca coloque esses arquivos de manifesto nesta lista.