# candidate-portal — variáveis de ambiente
# Copie para .env.local e ajuste para o seu ambiente:
#   cp .env.example .env.local

# Google Identity Services — Client ID para o botão "Continuar com Google".
# Deixe em branco ou remova a linha para desabilitar o botão Google no login.
# Obtenha em: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# URL base da API pública (sem barra final).
# Em desenvolvimento local aponta para o backend FastAPI.
# Em produção substituir pelo domínio/CDN real da API.
#
# REGRA CRÍTICA DE HOST (cookie de sessão SameSite=Lax):
# o host desta URL DEVE ser o MESMO host pelo qual você abre o portal no navegador.
# - portal em http://localhost:5174  → use http://localhost:8000/api/v1/public
# - portal em http://192.168.1.88:5174 → use http://192.168.1.88:8000/api/v1/public
# Misturar localhost / 127.0.0.1 / IP-de-rede faz o navegador criar o cookie em um
# host e NÃO reenviá-lo para o outro: /me e /me/applications retornam 401.
VITE_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1/public
VITE_API_URL=http://localhost:8000/api/v1
# Para LAN/dev, `npm run dev:full -- --network` injeta dinamicamente:
# VITE_PUBLIC_API_BASE_URL=http://SEU_IP_LOCAL:8000/api/v1/public
# VITE_API_URL=http://SEU_IP_LOCAL:8000/api/v1

# DEV ONLY. Exibe o bloco "Acesso rápido de desenvolvimento" em /login.
# Requer ENABLE_DEV_CANDIDATE_LOGIN=true no backend e só aparece em `vite dev`.
VITE_ENABLE_DEV_CANDIDATE_LOGIN=false

# Fallback de compatibilidade: se VITE_PUBLIC_API_BASE_URL não for definida,
# o client usa VITE_API_URL + "/public". Mantenha o mesmo host aqui também.

# Nota sobre CORS em desenvolvimento
# O candidate-portal faz chamadas cross-origin para o backend (localhost:5174 → localhost:8000).
# O backend deve ter CORS configurado para aceitar a origem http://localhost:5174
# com credenciais (Access-Control-Allow-Credentials: true).
# Não use um proxy Vite como atalho: ele mascararia problemas de CORS que
# apareceriam em produção quando portal e API estiverem em domínios distintos.
