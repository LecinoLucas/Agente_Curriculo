# candidate-portal — variáveis de ambiente
# Copie para .env.local e ajuste para o seu ambiente:
#   cp .env.example .env.local

# URL base da API pública (sem barra final).
# Em desenvolvimento local aponta para o backend FastAPI.
# Em produção substituir pelo domínio/CDN real da API.
VITE_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1/public

# Nota sobre CORS em desenvolvimento
# O candidate-portal faz chamadas cross-origin para o backend (localhost:5174 → localhost:8000).
# O backend deve ter CORS configurado para aceitar a origem http://localhost:5174
# com credenciais (Access-Control-Allow-Credentials: true).
# Não use um proxy Vite como atalho: ele mascararia problemas de CORS que
# apareceriam em produção quando portal e API estiverem em domínios distintos.
