# ─────────────────────────────────────────────────────────────────────────────
# .env.docker.example — Docker local stack environment
# SECURITY: Copy to .env.docker and fill in real secrets.
#   cp .env.docker.example .env.docker
# NEVER commit .env.docker to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL container ──────────────────────────────────────────────────────
POSTGRES_DB=resume_ai
POSTGRES_USER=resume_user
POSTGRES_PASSWORD=changeme

# ── Backend application ───────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=your-secret-key-min-32-chars-change-this
APP_DEBUG=false

# DATABASE_URL must use service name "postgres" (not localhost) inside Docker.
DATABASE_URL=postgresql+asyncpg://resume_user:changeme@postgres:5432/resume_ai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# REDIS_URL must use service name "redis" (not localhost) inside Docker.
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=20

# Celery also uses service names.
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# Worker memory limit in KB — process is recycled after reaching this RSS.
CELERY_WORKER_MAX_MEMORY_PER_CHILD=300000

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# Browser origins that can send credentials to the backend.
# localhost:5173 = staff frontend, localhost:5174 = candidate portal.
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# ── Candidate portal public URL (used in password-reset emails) ───────────────
CANDIDATE_PORTAL_PUBLIC_URL=http://localhost:5174

# ── Dev admin seeding ─────────────────────────────────────────────────────────
DEV_ADMIN_EMAIL=admin@resume.ai
DEV_ADMIN_PASSWORD=Smoke123!
DEV_ADMIN_FULL_NAME=Administrador Dev

# ── AI provider ───────────────────────────────────────────────────────────────
# SECURITY: add real keys only in .env.docker, never in this example file.
AI_PROVIDER=google
AI_MODEL_ID=gemini-2.5-flash
AI_PROVIDER_TIMEOUT_SECONDS=300
AI_MAX_TOKENS=3000
AI_MAX_RETRIES=0
ALLOW_AI_TOKEN_SPEND=true

GOOGLE_API_KEY_1=coloque-sua-chave-aqui
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=
GOOGLE_API_KEY_4=
GOOGLE_API_KEY_5=

ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=4096

# ── AWS / S3 (optional — leave blank to disable) ──────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=resume-ai-files
S3_PRESIGNED_URL_EXPIRE_SECONDS=900

# ── SMTP (optional — leave blank to disable email) ────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Marajó RH
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=10

# ── ERP / Protheus (dry_run by default — safe) ────────────────────────────────
ERP_INTEGRATION_MODE=dry_run
PROTHEUS_BASE_URL=
PROTHEUS_AUTH_MODE=basic
PROTHEUS_USERNAME=
PROTHEUS_PASSWORD=
PROTHEUS_TOKEN=
PROTHEUS_TIMEOUT_SECONDS=30
PROTHEUS_REAL_SEND_ENABLED=false
ERP_ALLOW_REAL_SEND=false

# ── Encryption ────────────────────────────────────────────────────────────────
FIELD_ENCRYPTION_KEY=your-base64-32-byte-key-change-this

# ── Google OAuth (optional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google-calendar/callback

# ── Dev flags ─────────────────────────────────────────────────────────────────
ENABLE_DEV_MOCK=false
ENABLE_DEV_CANDIDATE_LOGIN=false

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Pipeline ──────────────────────────────────────────────────────────────────
PIPELINE_BOARD_MAX_ROWS=500
SKILL_CATALOG_SOURCE=database

# ── Frontend build args (used by docker-compose build args, not backend) ──────
# These are read by docker-compose.local.yml to pass as --build-arg to Vite.
# VITE_ vars are baked into the JS bundle — change requires a rebuild.
VITE_API_BASE_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000/api/v1
VITE_CANDIDATE_PORTAL_URL=http://localhost:5174
VITE_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1/public
VITE_GOOGLE_CLIENT_ID=
VITE_ENABLE_DEV_CANDIDATE_LOGIN=false
